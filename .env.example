# ==============================================================================
# SEO Research & Blog Drafting Automation - Environment Configuration
# ==============================================================================

# AI Provider Settings
# Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini  # 'gemini' or 'mock' (for tests/offline simulation)

# Business & Geographical Scope
TARGET_COUNTRY=India
TARGET_STATE=Uttar Pradesh
# Specific student cities in Uttar Pradesh
TARGET_CITIES=Greater Noida,Noida,Lucknow,Kanpur,Varanasi,Prayagraj,Ghaziabad
COMPANY_NAME=CampusNest UP  # Replace with actual student accommodation brand name
COMPANY_WEBSITE=https://campusnest-up.example.com
BRAND_VOICE=Empathetic, practical, knowledgeable, student-first, and transparent

# Gmail Delivery (OAuth 2.0)
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_RECIPIENT_EMAIL=editorial_team@gmail.com
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
EMAIL_DRY_RUN=true  # Set to false once Gmail OAuth is configured to send real emails

# Scoring Weights (Must sum to 1.0 or normalized)
WEIGHT_ACCOMMODATION_RELEVANCE=0.35
WEIGHT_TREND_OPPORTUNITY=0.20
WEIGHT_RANKING_OPPORTUNITY=0.20
WEIGHT_BUSINESS_VALUE=0.25

# Minimum Thresholds
MIN_TOPIC_SCORE=55.0
MIN_BUSINESS_RELEVANCE=50.0
MAX_COMPETITORS=5
MIN_COMPETITORS=2

# Content Guidance
DRAFT_LANGUAGE=English
MIN_WORD_COUNT=1000
MAX_WORD_COUNT=2200

# Reliability & Paths
TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/seo_automation.db
OUTPUT_DIRECTORY=output
LOGS_DIRECTORY=logs
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
